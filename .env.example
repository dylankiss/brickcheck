# Frontend (copy to .env.local). Values come from `npx supabase status` or the Supabase dashboard.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: public address used in invite links (defaults to the current origin).
VITE_PUBLIC_URL=
# Optional: Cloudflare Turnstile site key (public). Leave empty locally: no CAPTCHA widget, no token.
VITE_TURNSTILE_SITE_KEY=
